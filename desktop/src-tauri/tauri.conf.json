{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "鲸鲸",
  "version": "0.1.0",
  "identifier": "life.jingjing.desktop",
  "build": {
    "frontendDist": "assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "鲸鲸",
        "url": "http://127.0.0.1:7700/",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "resources": [],
    "shortDescription": "会记得你的本地数字生命",
    "longDescription": "鲸鲸的桌面壳：它只负责把本地服务装进一个原生窗口。删掉壳，jingjing serve 7700 仍提供全部能力。"
  }
}
