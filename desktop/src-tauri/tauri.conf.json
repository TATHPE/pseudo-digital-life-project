{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pseudo Digital Life Project",
  "version": "0.1.1",
  "identifier": "life.pseudolife.desktop",
  "build": {
    "frontendDist": "assets",
    "beforeBuildCommand": {
      "script": "node tools/sync-desktop.ts --if-needed",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pseudo Digital Life Project",
        "url": "index.html",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "resizable": true,
        "center": true,
        "maximized": true,
        "backgroundColor": "#050706"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../bundle-src/app": "app",
      "../bundle-src/node": "node"
    },
    "shortDescription": "会记得你的本地数字生命",
    "longDescription": "Pseudo Digital Life Project 的桌面壳：它只负责把本地服务装进一个原生窗口。删掉壳，jingjing serve 7700 仍提供全部能力。"
  }
}
